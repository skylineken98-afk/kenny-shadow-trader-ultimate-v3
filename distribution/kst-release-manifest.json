{
  "name": "KST Unified Distribution",
  "version": "0.1.0-rc0",
  "release_status": "PREVIEW_NOT_PRODUCTION_READY",
  "assets": [
    "options",
    "stocks",
    "spot_crypto",
    "futures_signals_research",
    "private_futures_simulation"
  ],
  "modules": [
