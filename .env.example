# Do NOT commit real secrets. Set these in each Railway/Cloudflare service, not in the repo.
# --- Shared (all Railway services) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# --- Original scanner service (workers.scan_worker) ---
APP_PASSWORD=
SCAN_SYMBOLS=SPY,QQQ,IWM,AAPL,MSFT,NVDA,TSLA,BTC-USD,ETH-USD
SCAN_INTERVAL_SECONDS=3600
PAPER_AUTO_ENABLED=false
PAPER_RESEARCH_EQUITY=10000
PAPER_INTERVAL_SECONDS=3600
ALLOW_LIVE_ORDERS=false
# --- Options service (python -m kst_options.worker) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
OPTIONS_FEED=opra
OPTIONS_SYMBOLS=SPY,QQQ,IWM
OPTIONS_SCAN_SECONDS=300
OPTIONS_TRACK_SECONDS=60
OPTIONS_ROUND_TRIP_FEE=0
OPTIONS_PAPER_AI_ENABLED=true
STOCK_RESEARCH_ENABLED=true
STOCK_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMD,AMZN,META,GOOGL,SOFI,HOOD
STOCK_FEED=iex
NEWS_RSS_URLS=
NEWS_POLL_SECONDS=300
# --- Push service (python -m kst_options.push_worker) ---
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# --- Chat service (python -m kst_chat.server) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
SUPABASE_PUBLISHABLE_KEY=
CHAT_PROXY_TOKEN=
CHAT_ALLOWED_EMAILS=
CHAT_DAILY_LIMIT=40
CHAT_GLOBAL_DAILY_LIMIT=500
CHAT_MAX_OUTPUT_TOKENS=3000
# Optional: legacy anon key, only if you do not use SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=
# Set automatically by Railway for the chat service; override only if needed
PORT=
# --- r5 Pro worker (earnings/news, private positions, research, health) ---
FINNHUB_API_KEY=
KST_ADMIN_USER_IDS=
MONITOR_SERVICES=scanner,options,push,chat,pro
MEMBERSHIP_ENFORCED=false
# --- r5 Billing on chat service; subscriptions remain inactive without configuration ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
KST_SITE_URL=
BILLING_LIVE_MODE=false
# --- r5 Encrypted backups: configure a persistent volume and an independent key backup ---
BACKUP_ENABLED=false
DATABASE_URL=
RESTORE_DATABASE_URL=
BACKUP_DIRECTORY=/backups
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP=7
# --- r5 Dedicated owner execution service. NEVER use website-supplied credentials ---
LIVE_TRADING_ENABLED=false
LIVE_DEDICATED_ACCOUNT=false
LIVE_RISK_ACK=
LIVE_ACCOUNT_ID=
LIVE_ALPACA_API_KEY=
LIVE_ALPACA_API_SECRET=
LIVE_ASSET=equity
LIVE_SYMBOLS=SPY,QQQ,IWM
LIVE_STOCK_FEED=iex
LIVE_ALLOCATION=100
LIVE_MAX_ORDER=60
LIVE_MAX_DAY_LOSS=10
